{
  "name": "server",
  "version": "1.0.0",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "cd .. && npx electron server/src/main.js",
    "build": "electron-builder build --dir",
    "dist": "electron-builder build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sql.js": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dascomsoft.gestionbulletin",
    "productName": "Gestion Bulletin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "!**/node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  }
}