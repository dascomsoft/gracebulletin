{
  "name": "server",
  "version": "1.0.0",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
  "start": "electron",
    "build": "electron-builder build --dir",
   "dev": "cd .. && npx electron server/src/main.js",
    "dist": "electron-builder build",
    "pack": "electron-builder build --dir"
  },
  "dependencies": {
    "electron": "^22.0.0",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.dascomsoft.gestionbulletin",
    "productName": "Gestion Bulletin",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "src/**/*",
      "../../frontend/dist/**/*",
      "!**/node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}